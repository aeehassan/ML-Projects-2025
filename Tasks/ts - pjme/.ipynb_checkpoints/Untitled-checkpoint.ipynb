    "# Number of bins (e.g., 5 parts)\n",
    "num_bins = 8\n",
    "\n",
    "# Split into bins\n",
    "y['bin'] = pd.qcut(y.index, num_bins, labels=False)\n",
    "\n",
    "# Plot each bin separately\n",
    "for i in range(num_bins):\n",
    "    sns.set_style(\"darkgrid\")\n",
    "    subset = y[y['bin'] == i]\n",
    "    plt.figure(figsize=(12, 6))\n",
    "    sns.lineplot(data=subset, x='date', y='true', color='green', label='Actual')\n",
    "    sns.lineplot(data=subset, x='date', y='pred', color='blue', label='Forecasted')\n",
    "\n",
    "    plt.title(f'Actual vs Forecasted (Bin {i+1})', fontsize=16)\n",
    "    plt.xlabel('Date')\n",
    "    plt.ylabel('Energy')\n",
    "    plt.legend()\n",
    "    plt.show()"
   ]
